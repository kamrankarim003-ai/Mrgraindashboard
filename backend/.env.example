# Email (SMTP) - leave blank in dev; emails will be logged instead of sent.
# NEVER put real passwords in this file - it is committed to git.
# Put real values in backend/.env (which is gitignored) instead.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your@gmail.com,
# SMTP_PASS=your 16-char app password (no spaces) from https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MR GRAIN <no-reply@mrgrain.com.au>"
